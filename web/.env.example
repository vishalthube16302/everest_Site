# Copy to .env.local. Values are in the Supabase dashboard for Everest V2.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Set to true only at launch. Until then every page is noindex.
SITE_INDEXABLE=false

# Public address of the site. Used for canonical links, the sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://everesthps.com
# Films and scroll frames are read from here. Leave empty to use this site's own /films folder.
# Example: https://films.example.com (the files keep the same /films/... paths).
NEXT_PUBLIC_FILMS_BASE_URL=
# Google Analytics 4 measurement ID (public). Set only in the production host. Empty means no tracking.
NEXT_PUBLIC_GA_ID=
