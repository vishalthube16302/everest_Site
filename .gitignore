# Dependencies and build output
node_modules/
dist/
dist-ssr/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# Secrets and local settings. Never commit these.
.env
.env.*
!.env.example
*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Python caches
__pycache__/
*.pyc

# Editors and system files
.vscode/
.idea/
.DS_Store
*.suo
*.sw?

# Temporary and AI metadata
supabase/.temp/
.bolt/
.vite-react-ssg-temp

# Database backups
backup/
backup.sql

# Film renderer output (large; see docs/ops/film-hosting.md)
tools/video/*.mp4
tools/video/still-*.jpg

# Built from web/redirects.txt on every build
web/public/_redirects
